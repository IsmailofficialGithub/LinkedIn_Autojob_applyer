{
  "name": "autolinkedapply",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "node --test",
    "dev:all": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev\" \"npm run dev --prefix ../client\"",
    "client": "npm run dev --prefix ../client",
    "lint:all": "npm run lint && npm run lint --prefix ../client",
    "build:client": "npm run build --prefix ../client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "axios": "^1.18.0",
    "bullmq": "^5.78.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.0",
    "playwright": "^1.57.0",
    "puppeteer": "^25.1.0",
    "supertest": "^7.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4"
  }
